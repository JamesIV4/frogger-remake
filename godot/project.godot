; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Frogger Remake"
run/main_scene="uid://d3e6rdvnbnjf6"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://frogger.svg"

[display]

window/size/viewport_width=1100
window/size/viewport_height=960
window/size/window_width_override=1100
window/size/window_height_override=960
window/stretch/mode="canvas_items"
window/stretch/mode.web="viewport"
window/stretch/aspect="expand"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
; Godot 4.7's tighter caster culling can discard directional shadows as the
; native follow camera crosses cascade boundaries (godotengine/godot#121644).
lights_and_shadows/tighter_shadow_caster_culling.windows=false
anti_aliasing/quality/msaa_3d=2

[input_devices]

pointing/emulate_touch_from_mouse=true
