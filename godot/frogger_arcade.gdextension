[configuration]
entry_symbol = "frogger_arcade_library_init"
compatibility_minimum = "4.1"

[libraries]
windows.debug.x86_64 = "res://bin/libfrogger_arcade.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://bin/libfrogger_arcade.windows.template_release.x86_64.dll"
web.debug.wasm32 = "res://bin/libfrogger_arcade.web.template_debug.wasm32.wasm"
web.release.wasm32 = "res://bin/libfrogger_arcade.web.template_release.wasm32.wasm"
